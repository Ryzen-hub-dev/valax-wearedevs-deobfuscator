# Valax Source Recovery — Environment Configuration Placeholders
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO THIS FILE OR VERSION CONTROL.

# Application Environment
NODE_ENV=development
PORT=3000
WEB_PORT=8080

# Redis Queue & Orchestration
REDIS_URL=redis://127.0.0.1:6379

# MongoDB Persistence
MONGODB_URI=mongodb://127.0.0.1:27017/valax

# Product Guardrails & Quotas
MAX_SOURCE_BYTES=5242880
MAX_CONCURRENT_JOBS_PER_PRINCIPAL=5
MAX_JOBS_PER_DAY=100

# Retention Policies (in seconds)
SOURCE_RETENTION_SECONDS=0
ARTIFACT_RETENTION_SECONDS=86400
JOB_METADATA_RETENTION_SECONDS=604800

# Discord OAuth2 & Bot Configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=

# Production Session Security
SESSION_SECRET=
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=86400

# Internal Service-to-Service Secret (Bot -> Product API)
INTERNAL_BOT_SERVICE_SECRET=
