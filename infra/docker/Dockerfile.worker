# Production Hardened Recovery Worker Container
# Build the C++ preflight engine separately so the runtime image contains no compiler.
FROM alpine:3.20 AS native-build

RUN apk add --no-cache cmake g++ make
WORKDIR /src
COPY native ./native
RUN cmake -S native -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF && \
    cmake --build build --config Release --parallel

# Minimal Alpine Linux base with Node.js, Lua, and the native engine.
FROM node:20-alpine AS base

# Install lua5.1 for semantic oracle validation if needed
RUN apk add --no-cache lua5.1 lua5.1-libs

# Setup application directory
WORKDIR /app

# Copy dependency manifests and project files
COPY package.json package-lock.json* ./
COPY packages/core ./packages/core
COPY packages/shared ./packages/shared
COPY packages/sandbox ./packages/sandbox
COPY packages/worker ./packages/worker
COPY audit/core-baseline-hashes.json ./audit/core-baseline-hashes.json
COPY --from=native-build /src/build/valax-native /usr/local/bin/valax-native

# Prepare isolated work directories with correct ownership (node user is uid 1000, gid 1000)
RUN mkdir -p /work /tmp && \
    chown -R node:node /app /work /tmp && \
    chmod -R 555 /app

# Drop root privileges permanently
USER node:node

# Environment settings
ENV NODE_ENV=production
ENV HOME=/tmp
ENV TMPDIR=/tmp
ENV VALAX_NATIVE_ENGINE_PATH=/usr/local/bin/valax-native

# Stdin/stdout IPC entrypoint
ENTRYPOINT ["node", "/app/packages/worker/src/index.js"]
